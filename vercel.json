{
  "buildCommand": "cd ui/react_frontend && npm install && npm run build",
  "outputDirectory": "ui/react_frontend/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{ui,assets,tests,.streamlit,README.md}/**"
    }
  }
}
